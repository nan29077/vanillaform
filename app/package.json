{
  "name": "vanillaform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "guard:isolation": "node scripts/assert-isolated-env.mjs",
    "predev": "npm run guard:isolation",
    "dev": "next dev -p 3026",
    "prebuild": "npm run guard:isolation",
    "build": "next build",
    "postinstall": "prisma generate",
    "prestart": "npm run guard:isolation",
    "start": "next start -p 3026",
    "lint": "next lint",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:push": "node scripts/assert-isolated-env.mjs && prisma db push",
    "db:migrate": "node scripts/assert-isolated-env.mjs && prisma migrate dev",
    "db:seed": "node scripts/assert-isolated-env.mjs && npx tsx prisma/seed.ts",
    "db:seed-node": "node scripts/assert-isolated-env.mjs && npx tsx prisma/seed-node.ts",
    "db:studio": "node scripts/assert-isolated-env.mjs && prisma studio"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.1086.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.577.0",
    "next": "^14.2.35",
    "next-auth": "^5.0.0-beta.30",
    "puppeteer": "^24.40.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.72.0",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.1",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "config": {
    "puppeteer_skip_download": "true"
  }
}
