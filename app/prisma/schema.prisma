}

// ─────────────────────────────────────────────
// 중간관리자 직접 정산 (관리자 → 중간관리자)
// ─────────────────────────────────────────────

model MiddleManagerSettlement {
  id            String             @id @default(cuid())
  middleAdminId String
  middleAdmin   MiddleAdminProfile @relation(fields: [middleAdminId], references: [id])
  periodLabel   String             // 정산 기간 표시 (예: "2025년 1월")
  totalAmount   Decimal            @db.Decimal(12, 2)
  status        SettlementStatus   @default(PENDING)
  memo          String?            @db.Text
  paidAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([middleAdminId])
  @@map("middle_manager_settlements")
}

// ─────────────────────────────────────────────
// 배너 (CMS)
// ─────────────────────────────────────────────

model Banner {
  id        String    @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  position  String    @default("hero")
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("banners")
}

// ─────────────────────────────────────────────
// 콘텐츠/룩북
// ─────────────────────────────────────────────

model ContentPost {
  id          String        @id @default(cuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id])
  title       String
  content     String?       @db.Text
  images      String?       @db.Text
  category    String?
  hashtags    String?       @db.Text
  productTags String?       @db.Text
  isPublished Boolean       @default(false)
  isApproved  Boolean       @default(false)
  viewCount   Int           @default(0)
  likeCount   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  shoppingTags ShoppingTag[]
  likes        ContentLike[]
  comments     ContentComment[]

  @@map("content_posts")
}

// ─────────────────────────────────────────────
// 쇼핑 태그 (이미지 위 상품 태그)
// ─────────────────────────────────────────────

model ShoppingTag {
  id         String      @id @default(cuid())
  contentId  String
  content    ContentPost @relation(fields: [contentId], references: [id], onDelete: Cascade)
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageIndex Int         @default(0)
  posX       Float
  posY       Float
  label      String?
  createdAt  DateTime    @default(now())

  @@map("shopping_tags")
}

// ─────────────────────────────────────────────
// 콘텐츠 좋아요
// ─────────────────────────────────────────────

model ContentLike {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId String
  content   ContentPost @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userId, contentId])
  @@map("content_likes")
}

// ─────────────────────────────────────────────
// 콘텐츠 댓글
// ─────────────────────────────────────────────

model ContentComment {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId String
  content   ContentPost      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  text      String           @db.Text
  parentId  String?
  parent    ContentComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ContentComment[] @relation("CommentReplies")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([contentId])
  @@map("content_comments")
}

// ─────────────────────────────────────────────
// 알림
// ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  @@map("notifications")
}

// ─────────────────────────────────────────────
// 라이브 커머스
// ─────────────────────────────────────────────

enum LiveStreamStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model LiveStream {
  id              String           @id @default(cuid())
  sellerId        String
  seller          SellerProfile    @relation(fields: [sellerId], references: [id])
  title           String
  description     String?          @db.Text
  thumbnailImage  String?
  status          LiveStreamStatus @default(SCHEDULED)
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  vodUrl          String?
  rtmpUrl         String?
  streamKey       String?
  platform        String?
  externalUrl     String?          @db.Text
  shareCode       String           @unique
  viewerCount     Int              @default(0)
  peakViewerCount Int              @default(0)
  likeCount       Int              @default(0)
  isVodSaved      Boolean          @default(false)
  kakaoNotified   Boolean          @default(false)
  showPastInShop  Boolean          @default(false)
  // 채널 페이지: 방송 종료(OFF) 상태 설정
  offThumbnailUrl String?          // 방송 종료 후 표시 썸네일
  offLinkUrl      String?          // 종료 후 링크 URL
  offLinkText     String?          @default("자세히 보기") // 링크 버튼 텍스트
  // YouTube 실시간 채팅 수집 커서 (셀러 API 키로 폴링해 앱 채팅에 병합)
  ytLiveChatId    String?          // videos.list 로 조회한 activeLiveChatId 캐시
  ytNextPageToken String?          @db.Text // liveChat/messages 다음 페이지 커서
  ytSyncedAt      DateTime?        // 마지막 YouTube 채팅 폴링 시각 (throttle 용)
  ytChatForward   Boolean          @default(true) // 사이트 채팅 → YouTube 라이브 채팅 전달 (셀러 OAuth 계정 명의로 게시)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  products     LiveStreamProduct[]
  chatMessages LiveChatMessage[]
  coupons      LiveCoupon[]

  @@index([sellerId])
  @@index([shareCode])
  @@index([status])
  @@map("live_streams")
}

model LiveStreamProduct {
  id           String     @id @default(cuid())
  liveStreamId String
  liveStream   LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  livePrice    Decimal?   @db.Decimal(12, 2)
  createdAt    DateTime   @default(now())

  @@unique([liveStreamId, productId])
  @@map("live_stream_products")
}

model LiveChatMessage {
  id           String     @id @default(cuid())
  liveStreamId String
  liveStream   LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  userId       String?
  nickname     String     @default("익명")
  message      String     @db.Text
  isManager    Boolean    @default(false)
  isSystem     Boolean    @default(false)
  isBot        Boolean    @default(false) // AI 챗봇이 발송한 메시지
  isHidden     Boolean    @default(false) // 스팸/금지어 필터로 숨김 처리된 메시지
  isYoutube    Boolean    @default(false) // YouTube 라이브 채팅에서 수집한 메시지 (YT 배지 표시)
  ytMessageId  String?    @db.VarChar(191) // YouTube 메시지 ID (중복 수집 방지용)
  createdAt    DateTime   @default(now())

  @@unique([liveStreamId, ytMessageId])
  @@index([liveStreamId])
  @@map("live_chat_messages")
}

// 라이브 채널 공지사항 (셀러 단위)
model LiveChannelNotice {
  id        String        @id @default(cuid())
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title     String
  content   String        @db.Text
  isPinned  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([sellerId])
  @@map("live_channel_notices")
}

// AI YouTube 채팅 봇 설정 (셀러당 1개)
// keywords/bannedWords/faqs 는 String? @db.Text 에 JSON 직렬화 저장 (MySQL 배열 미지원)
model ChatBotConfig {
  id       String        @id @default(cuid())
  sellerId String        @unique
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false) // 봇 전체 ON/OFF

  // 1. 자동 인사 (시청자 첫 채팅 감지 시 환영 메시지)
  greetingEnabled Boolean @default(true)
  greetingMessage String? @db.Text

  // 2. 키워드 자동 응답 — JSON: [{ keyword, response }]
  keywordEnabled Boolean @default(true)
  keywords       String? @db.Text

  // 3. 상품 정보 자동 안내 ("N번 상품", "가격", "재고" 질문 자동 응답)
  productInfoEnabled Boolean @default(true)

  // 4. 스팸/욕설 필터 — JSON: [금지어]
  spamFilterEnabled Boolean @default(true)
  bannedWords       String? @db.Text

  // 5. FAQ 자동 응답 — JSON: [{ question, answer }]
  faqEnabled Boolean @default(true)
  faqs       String? @db.Text

  // 6. 구매 유도 메시지 (분 단위 주기)
  purchaseNudgeEnabled  Boolean @default(false)
  purchaseNudgeMessage  String? @db.Text
  purchaseNudgeInterval Int     @default(5)

  // 7. 라이브 통계 공지 (분 단위 주기)
  statsEnabled  Boolean @default(false)
  statsInterval Int     @default(10)

  // 8. 쿠폰 코드 자동 공지 (분 단위 주기)
  couponEnabled  Boolean @default(false)
  couponInterval Int     @default(10)

  // 9. 봇 메시지 YouTube 채팅 동시 전송 (셀러 YouTube OAuth 연결 시에만 동작)
  youtubeSendEnabled Boolean @default(false)

  // 셀러 개인 YouTube Data API v3 키 (라이브 방송 YouTube 채팅 읽기용, 미설정 시 서버 공용 키 사용)
  youtubeApiKey String? @db.Text

  // 봇 엔진 런타임 커서 (라이브별 처리 위치 — 라이브가 바뀌면 리셋)
  activeLiveId    String?
  lastProcessedAt DateTime?
  lastNudgeAt     DateTime?
  lastStatsAt     DateTime?
  lastCouponAt    DateTime?
  ytLiveChatId    String?
  ytPageToken     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chat_bot_configs")
}

model LiveCoupon {
  id             String     @id @default(cuid())
  liveStreamId   String
  liveStream     LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  code           String     @unique
  discountType   String     // "PERCENT" | "AMOUNT"
  discountValue  Decimal    @db.Decimal(10, 2)
  validDays      Int        @default(7)
  maxCount       Int?
  minOrderAmount Decimal?   @db.Decimal(12, 2)
  issuedCount    Int        @default(0)
  createdAt      DateTime   @default(now())

  claims         UserCoupon[]

  @@index([liveStreamId])
  @@index([code])
  @@map("live_coupons")
}

model UserCoupon {
  id           String     @id @default(cuid())
  liveCouponId String
  liveCoupon   LiveCoupon @relation(fields: [liveCouponId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  claimedAt    DateTime   @default(now())
  usedAt       DateTime?

  @@unique([liveCouponId, userId])
  @@index([userId])
  @@map("user_coupons")
}

// ─────────────────────────────────────────────
// 상품별 채팅 (공급자-셀러 간 대화)
// ─────────────────────────────────────────────

model ProductChat {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  senderId   String
  senderRole String
  senderName String
  message    String   @db.Text
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([senderId])
  @@map("product_chats")
}

// ─────────────────────────────────────────────
// 결제 로그 (PG 통합)
// ─────────────────────────────────────────────

model PaymentLog {
  id        String   @id @default(cuid())
  orderId   String?
  provider  String
  stage     String
  status    String
  message   String   @db.Text
  payload   String?  @db.LongText
  pgTid     String?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([provider, stage])
  @@index([createdAt])
  @@map("payment_logs")
}

// ─────────────────────────────────────────────
// NextAuth OAuth 표준 모델
// ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────
// 전역 설정
// ─────────────────────────────────────────────

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// 시스템 전역 스위치 (노드 시스템 ON/OFF 등, 단일 레코드 id=1)
model SystemConfig {
  id            Int      @id @default(1)
  nodeEnabled   Boolean  @default(true)
  sellerOnlyFee Boolean  @default(false) // true: 플랫폼 수수료 전액 셀러 부담 (공급자 수수료 없음)
  updatedAt     DateTime @updatedAt

  @@map("system_config")
}

// 역할별 플랫폼 수수료율 설정 (최고관리자 전용, 단일 레코드)
model PlatformFeeSettings {
  id                 Int      @id @default(autoincrement())
  sellerFeeRate      Decimal  @default(5.00) @db.Decimal(5, 2)
  middleAdminFeeRate Decimal  @default(5.00) @db.Decimal(5, 2)
  brandFeeRate       Decimal  @default(5.00) @db.Decimal(5, 2)
  nodeFeeRate              Decimal  @default(5.00) @db.Decimal(5, 2)
  mentorCommissionRate     Decimal  @default(1.00) @db.Decimal(5, 2) // 멘토 셀러 추천인 커미션율 (기본 1%)
  updatedAt                DateTime @updatedAt

  @@map("platform_fee_settings")
}

// ─────────────────────────────────────────────
// 게임 관리 (OBS 오버레이용)
// ──────────
model Game {
  id        String        @id @default(cuid())
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id])
  // "ROULETTE" | "LADDER" | "DRAW" | "KEYWORD" | "NUMBER_GUESS"
  // | "QUIZ" | "VOTE" | "GOAL_GAUGE" | "BOX_OPEN" | "SEQUENTIAL"
  type      String
  title     String
  items     String        @db.Text // JSON array of items
  config    String?       @db.Text // JSON: 타입별 설정 (정답/선택지/보상/확률 등)
  status    String        @default("IDLE") // IDLE, RUNNING, FINISHED
  result    String?       @db.Text // JSON result
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  participants GameParticipant[]
  gameCoupons  GameCoupon[]

  @@index([sellerId])
  @@map("games")
}

// 게임 쿠폰 (셀러가 게임에 연결한 쿠폰 정의) — 당첨자에게 발급
model GameCoupon {
  id             String   @id @default(cuid())
  gameId         String
  game           Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  code           String? // null 이면 발급 시 자동 생성
  discountType   String // "PERCENT" | "AMOUNT" | "PURCHASE"
  discountValue  Int // PERCENT: 할인율(%), AMOUNT: 할인액(원), PURCHASE: 구매 고정가(원)
  minOrderAmount Int      @default(0)
  maxIssueCount  Int? // null = 무제한
  validDays      Int      @default(7) // 게임 종료 후 N일 유효
  productId      String? // PURCHASE 타입에서만 사용 — 특정 상품 ID
  createdAt      DateTime @default(now())

  issuedCoupons UserGameCoupon[]

  @@index([gameId])
  @@map("game_coupons")
}

// 발급된 게임 쿠폰 (당첨자 개인 소유) — 특정 셀러 샵에서만 사용 가능
model UserGameCoupon {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameCouponId String
  gameCoupon   GameCoupon @relation(fields: [gameCouponId], references: [id], onDelete: Cascade)
  gameId       String // 어느 게임에서 받았는지
  sellerId     String // 어느 셀러 샵에서만 사용 가능
  code         String // 실제 사용 코드 (자동 생성, 유니크)
  usedAt       DateTime? // null 이면 미사용
  expiresAt    DateTime // 만료일
  createdAt    DateTime   @default(now())

  @@unique([userId, gameCouponId]) // 같은 게임 쿠폰은 1인 1회
  @@unique([code])
  @@index([userId])
  @@index([sellerId])
  @@map("user_game_coupons")
}

// 게임 참여자 (익명/로그인 모두 가능, QR·오버레이 참여)
model GameParticipant {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String // 참여자 표시명
  entry     String? // 입력값 (숫자, 키워드 등)
  createdAt DateTime @default(now())

  @@index([gameId])
  @@map("game_participants")
}

// ─────────────────────────────────────────────
// Alimtalk (Kakao Business Message)
// ─────────────────────────────────────────────

model AlimtalkAccount {
  id         String        @id @default(cuid())
  sellerId   String        @unique
  seller     SellerProfile @relation(fields: [sellerId], references: [id])
  apiKey     String?       // Alimtalk service API key
  senderKey  String?       // Kakao channel sender profile key
  balance    Int           @default(0) // remaining credits (units)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  charges    AlimtalkCharge[]
  logs       AlimtalkLog[]

  @@map("alimtalk_accounts")
}

model AlimtalkCharge {
  id          String          @id @default(cuid())
  accountId   String
  account     AlimtalkAccount @relation(fields: [accountId], references: [id])
  amount      Int             // charge amount in KRW
  vat         Int             // VAT in KRW
  totalAmount Int             // actual payment amount in KRW
  credits     Int             // number of credits charged
  payMethod   String          // "card" | "easy_pay" | "bank_transfer"
  payStatus   String          @default("PENDING") // PENDING, PAID, FAILED
  pgTid       String?         // PG transaction ID
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("alimtalk_charges")
}

model AlimtalkLog {
  id             String          @id @default(cuid())
  accountId      String
  account        AlimtalkAccount @relation(fields: [accountId], references: [id])
  templateCode   String          // template code
  recipientCount Int             // number of recipients
  costPerMsg     Int             @default(15) // 15 KRW per message
  totalCost      Int             // total deducted amount
  status         String          @default("SENT") // SENT | FAILED
  createdAt      DateTime        @default(now())

  @@map("alimtalk_logs")
}

// 알림톡 용도(purpose)별 사용할 알리고 템플릿 매핑 — 관리자 알림톡 화면에서 설정.
// 발송 엔진(lib/alimtalkEngine.ts)이 발송 시점에 알리고에서 템플릿 원문을 조회해
// 변수만 치환하므로, 여기에는 어떤 템플릿을 쓸지(tplCode)와 on/off만 저장한다.
model AlimtalkTemplateSetting {
  id        String   @id @default(cuid())
  purpose   String   @unique // LIVE_START | ORDER_PLACED | SHIPPING_START | SIGNUP_WELCOME
  tplCode   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("alimtalk_template_settings")
}

// 알리고 실발송 기록 — 알림톡/SMS가 실제로 알리고에 접수될 때마다 1건 기록.
// 플랫폼 공용 계정으로 발송하므로 셀러 귀속은 sellerId로 남긴다 (시스템 발송은 null).
model AligoSendLog {
  id             String         @id @default(cuid())
  sellerId       String?        // 발송을 유발한 셀러 (비밀번호 문자 등 시스템 발송은 null)
  seller         SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  kind           String         // "ALIMTALK" | "SMS"
  purpose        String         // "LIVE_START" | "PASSWORD_RESET" 등 발송 사유 코드
  templateCode   String?        // 알림톡 템플릿 코드 (SMS는 null)
  recipientCount Int            // 발송 시도 수신자 수
  acceptedCount  Int            // 알리고 접수 성공 수 (실제 전달 성공과는 다름)
  failCount      Int            @default(0)
  cost           Decimal?       @db.Decimal(10, 2) // 알리고 차감 비용(원), 응답에 없으면 null
  aligoMids      String?        @db.Text // 알리고 mid JSON 배열 — 전달 결과 사후 대조용
  errorMessage   String?        @db.Text
  liveStreamId   String?        // 라이브 방송 알림이면 해당 라이브 id
  createdAt      DateTime       @default(now())

  @@index([sellerId])
  @@index([createdAt])
  @@map("aligo_send_logs")
}

model FooterContent {
  id     String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("footer_contents")
}

// ─────────────────────────────────────────────
// 소셜(카카오) 주문
// ─────────────────────────────────────────────

model SocialOrder {
  id            String    @id @default(cuid())
  productId     String
  sellerId      String
  name          String
  address       String
  phone         String
  depositorName String?
  snsAccounts   String?   @db.Text
  snsPlatform   String?
  snsHandle     String?
  snsNickname   String?
  quantity      Int?
  status        String?
  createdAt     DateTime? @default(now())
  updatedAt     DateTime? @updatedAt

  @@map("social_orders")
}

// -------------------------------------------------
// Manual Settlement (admin direct input)
// -------------------------------------------------

model ManualSettlement {
  id            String   @id @default(cuid())
  recipientType String
  recipientId   String
  amount        Int
  memo          String?  @db.Text
  status        String   @default("PAID")
  paidAt        DateTime @default(now())
  adminId       String
  admin         User     @relation("AdminManualSettlements", fields: [adminId], references: [id])
  createdAt     DateTime @default(now())

  @@index([recipientId])
  @@index([recipientType])
  @@index([adminId])
  @@map("manual_settlements")
}

// ─────────────────────────────────────────────
// 패키지 상품 시스템
// ─────────────────────────────────────────────

// 패키지 상품 (여러 브랜드 상품을 묶어 하나의 상품으로 판매)
model PackageProduct {
  id           String   @id @default(cuid())
  name         String
  description  String?  @db.Text
  imageUrl     String?
  packagePrice Decimal  @db.Decimal(10, 2) // 패키지 판매가 (등록자가 직접 설정)
  stock        Int      @default(0)
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectReason String?  @db.Text

  // 중간관리자 마진 (하위 브랜드 패키지에 중간관리자가 추가하는 마진)
  middleAdminMargin Decimal? @db.Decimal(10, 2)

  creatorId   String // 패키지 등록자 User.id
  creatorRole String // SUPER_ADMIN | BRAND_ADMIN | SELLER | MIDDLE_ADMIN

  creator            User                 @relation("PackageCreator", fields: [creatorId], references: [id])
  items              PackageItem[]
  packageOrderItems  PackageOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([status])
  @@map("package_products")
}

// 패키지 구성 상품 (패키지에 포함된 개별 상품)
model PackageItem {
  id        String  @id @default(cuid())
  packageId String
  productId String
  unitPrice Decimal @db.Decimal(10, 2) // 등록 시점 개별 상품 단가 (발주서용)
  quantity  Int     @default(1)

  package PackageProduct @relation(fields: [packageId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])

  @@index([packageId])
  @@index([productId])
  @@map("package_items")
}

// 패키지 주문 아이템 (패키지 상품 구매 1건)
model PackageOrderItem {
  id           String  @id @default(cuid())
  orderId      String  // 연결된 원 주문 ID (Order.id) — 패키지 결제를 기존 주문에 연결
  packageId    String
  quantity     Int
  packagePrice Decimal @db.Decimal(10, 2) // 구매 시점 패키지 판매가

  // 구매자 배송 정보 (일반 Order 없이 직접 구매 시 저장)
  buyerName    String?
  buyerPhone   String?
  buyerAddress String? @db.Text
  buyerMemo    String?
  paymentMethod String? // 결제수단
  paidAt       DateTime? // 결제 완료 시각
  status       String  @default("PENDING") // PENDING | PAID | CANCELLED

  package        PackageProduct         @relation(fields: [packageId], references: [id])
  purchaseOrders PackagePurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageId])
  @@index([orderId])
  @@map("package_order_items")
}

// 패키지 발주서 (패키지 내 브랜드별 + 등록자)
model PackagePurchaseOrder {
  id                 String  @id @default(cuid())
  packageOrderItemId String
  recipientId        String  // 발주서 수신자 User.id
  recipientType      String  // BRAND | CREATOR
  productId          String? // 해당 개별 상품 (BRAND 타입만)
  productName        String? // 상품명 (snapshot)
  amount             Decimal @db.Decimal(10, 2) // 발주 금액
  status             String  @default("PENDING") // PENDING | CONFIRMED | SHIPPED | COMPLETED

  packageOrderItem PackageOrderItem @relation(fields: [packageOrderItemId], references: [id], onDelete: Cascade)
  recipient        User             @relation("PackagePurchaseOrderRecipient", fields: [recipientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageOrderItemId])
  @@index([recipientId])
  @@map("package_purchase_orders")
}
