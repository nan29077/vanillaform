generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "windows", "darwin-arm64"]
}

datasource db {
  provider = "mysql"
  url      = env("VANILLAFORM_DATABASE_URL")
}

// ─────────────────────────────────────────────
// 사용자 & 역할
// ─────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  NODE
  MIDDLE_ADMIN
  BRAND_ADMIN
  SELLER
  BUYER
}

// 중간관리자 마진 산정 방식
enum MarginMethod {
  PERCENTAGE // 퍼센테이지: marginRate(%) x 기준가(공급가 or 판매가)
  SUPPLY_BASE // 공급가 베이스(직접입력): 상품마다 공급가/마진/판매가를 직접 입력
}

// 퍼센테이지 방식일 때 기준이 되는 가격
enum MarginBase {
  SUPPLY // 공급가 기준
  SALE // 판매가 기준
}

// 상품 제공 방식
enum PriceModel {
  SUPPLY // 공급가로 제공: 브랜드는 공급가만 입력, 셀러가 판매가 직접 결정
  COMMISSION // 수수료로 제공: 브랜드가 판매가·수수료 지정, 셀러는 고정 판매가로만 판매
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String?
  role          Role      @default(BUYER)
  avatar        String?
  image         String?
  gender        String?
  phone         String?
  birthday      String?   // 생년월일 (YYYY-MM-DD)
  // 회원 기본 주소 (가입 시 선택 입력) — 배송지(Address)와 별개의 프로필 주소
  zipCode       String?   // 우편번호
  address1      String?   // 도로명/지번 주소
  address2      String?   // 상세주소
  isActive      Boolean   @default(true)
  // 임시 비밀번호(비밀번호 초기화) 발급 시 true → 로그인 직후 강제 재설정
  mustResetPassword Boolean @default(false)
  // 셀러 정산 계좌 정보
  bankName      String?
  bankAccount   String?
  bankHolder    String?
  // 셀러 추천인(멘토-멘티) 시스템
  sellerReferralCode String?  @unique // 셀러가입 추천인코드 (셀러 계정 생성 시 자동 발급, 예: SB4K9M2X)
  referredBySellerCode String?         // 가입 시 입력한 셀러가입 추천인코드
  mentorId       String?               // 추천인(멘토) 셀러의 userId
  mentor         User?   @relation("MentorMentee", fields: [mentorId], references: [id])
  mentees        User[]  @relation("MentorMentee")
  managedByMiddleAdminId String?
  managedByMiddleAdmin   MiddleAdminProfile? @relation("MiddleAdminManagedUsers", fields: [managedByMiddleAdminId], references: [id])
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  buyerProfile       BuyerProfile?
  sellerProfile      SellerProfile?
  brandProfile       BrandProfile?
  middleAdminProfile MiddleAdminProfile?

  accounts Account[]
  sessions Session[]

  orders          Order[]
  reviews         Review[]
  cartItems       CartItem[]
  addresses       Address[]
  notifications   Notification[]
  wishlists       Wishlist[]
  couponClaims    UserCoupon[]
  contentLikes    ContentLike[]
  contentComments ContentComment[]
  gameParticipations GameParticipant[]
  gameCoupons        UserGameCoupon[]
  // 노드가 마진 설정 후 최종 등록(승인)한 상품들
  nodeApprovedProducts Product[]        @relation("NodeApprovedProducts")
  // 노드가 관리하는 중간관리자 / 브랜드
  nodeManagedMiddleAdmins MiddleAdminProfile[] @relation("NodeManagedMiddleAdmins")
  nodeManagedBrands       BrandProfile[]       @relation("NodeManagedBrands")
  // 노드가 받는 정산 내역
  nodeSettlements         NodeSettlement[]     @relation("NodeUserSettlements")
  // 관리자가 생성한 수기 정산 내역
  adminManualSettlements  ManualSettlement[]   @relation("AdminManualSettlements")
  // 멘토로서 받는 커미션
  mentorCommissions       MentorCommission[]   @relation("MentorCommissions")
  // 멘티로서 발생한 커미션
  menteeCommissions       MentorCommission[]   @relation("MenteeCommissions")
  // 패키지 상품 (등록자)
  packageProducts         PackageProduct[]     @relation("PackageCreator")
  // 패키지 발주서 수신자
  packagePurchaseOrders   PackagePurchaseOrder[] @relation("PackagePurchaseOrderRecipient")

  @@map("users")
}

// ─────────────────────────────────────────────
// 중간관리자 프로필 (브랜드.셀러 모집/관리)
// ─────────────────────────────────────────────

model MiddleAdminProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  contactPhone String?
  isActive     Boolean  @default(true)
  isApproved   Boolean  @default(true)
  commissionRate Decimal @default(5) @db.Decimal(5, 2)

  // 사업자 정보 (정산용)
  bizNumber     String?
  companyName   String?
  bankName      String?
  accountNumber String?
  accountHolder String?

  // 담당 노드 (NODE 계정 User.id)
  assignedNodeId String?
  assignedNode   User?   @relation("NodeManagedMiddleAdmins", fields: [assignedNodeId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brands       BrandProfile[]
  sellers      SellerProfile[]
  commissions        MiddleAdminCommission[]
  settlements        MiddleAdminSettlement[]
  managerSettlements MiddleManagerSettlement[]
  brandSettlements   BrandSettlement[]       @relation("MiddleAdminBrandSettlements")
  managedUsers       User[]                  @relation("MiddleAdminManagedUsers")
  products           Product[]               @relation("MiddleAdminProducts")

  @@map("middle_admin_profiles")
}

// ─────────────────────────────────────────────
// 구매회원 프로필 (셀러 귀속)
// ─────────────────────────────────────────────

model BuyerProfile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  primarySellerId    String?
  primarySeller      SellerProfile? @relation("PrimarySellerFans", fields: [primarySellerId], references: [id])
  referralCode       String?
  referredBySellerId String?
  referredBySeller   SellerProfile? @relation("ReferredBuyers", fields: [referredBySellerId], references: [id])
  liveAlimtalkOptIn  Boolean        @default(true)
  notifyOrder        Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  follows              SellerFollower[]
  channelVerifications ChannelVerification[]

  @@map("buyer_profiles")
}

// ─────────────────────────────────────────────
// 셀러 프로필 (인플루언서)
// ─────────────────────────────────────────────

model SellerProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug            String  @unique
  shopName        String
  shopDescription String? @db.Text
  shopBanner      String?
  shopLogo        String?
  category        String?
  mood            String?
  shopThemeColor  String? @default("#377255")
  instagramUrl    String?
  youtubeUrl      String?
  tiktokUrl       String?
  facebookUrl     String?
  twitterUrl      String?
  youtubeChannelId String?
  // YouTube OAuth 2.0 (채팅 쓰기·채널 자동 감지용 — youtube.force-ssl 스코프)
  youtubeAccessToken  String?   @db.Text
  youtubeRefreshToken String?   @db.Text
  youtubeTokenExpiry  DateTime?
  youtubeChannelTitle String?
  isManualLive         Boolean @default(false)
  livePlatform         String?
  liveLink             String?
  manualLiveProductIds String? @db.Text
  isApproved           Boolean @default(false)
  isRecommended   Boolean @default(false)
  commissionRate  Decimal @default(5) @db.Decimal(5, 2)
  totalFans       Int     @default(0)
  totalSales      Decimal @default(0) @db.Decimal(12, 2)

  middleAdminId         String?
  middleAdmin           MiddleAdminProfile? @relation(fields: [middleAdminId], references: [id])
  middleAdminMarginRate Decimal             @default(0) @db.Decimal(5, 2)

  businessType           String? @default("non_business")
  // 사업자 여부 (true=사업자, false=비사업자) — 출금 시 원천징수 3.3% 적용 판단 기준
  isBusinessOperator     Boolean @default(false)
  representativeName     String?
  businessRegistrationNo String?
  telecomSalesLicenseNo  String?
  businessAddress        String?
  businessCategory       String?

  referralCode           String? @unique
  referralCommissionRate Decimal @default(0) @db.Decimal(5, 2)
  referralDiscountRate   Decimal @default(0) @db.Decimal(5, 2)
  pickDiscountRate       Decimal @default(0) @db.Decimal(5, 2)
  totalReferralEarnings  Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fans                 BuyerProfile[]        @relation("PrimarySellerFans")
  referredBuyers       BuyerProfile[]        @relation("ReferredBuyers")
  followers            SellerFollower[]
  shopProducts         SellerShopProduct[]
  registeredProducts   Product[]             @relation("SellerRegisteredProducts")
  campaigns            GroupBuyCampaign[]
  settlements          Settlement[]
  contentPosts         ContentPost[]
  orders               Order[]               @relation("SellerOrders")
  referralCommissions  ReferralCommission[]
  channelVerifications ChannelVerification[]
  liveStreams          LiveStream[]
  liveChannelNotices   LiveChannelNotice[]
  games                Game[]

  featureGroupBuy     Boolean @default(true)
  featureContent      Boolean @default(true)
  featureLiveCommerce Boolean @default(false)
  shopDirectExpose    Boolean @default(false)
  shopNumbering       Boolean @default(false)

  // 장바구니 할인 (셀러 부담) — 셀러별 소계가 기준금액 이상이면 % 할인. 할인액은 셀러 정산에서 차감.
  cartDiscountEnabled   Boolean @default(false)
  cartDiscountThreshold Decimal @default(0) @db.Decimal(12, 2)
  cartDiscountRate      Decimal @default(0) @db.Decimal(5, 2)

  // 라이브 채널 사이트 설정 (JSON 직렬화)
  liveSiteSettings    String? @db.Text

  payoutRequests PayoutRequest[]
  alimtalkAccount AlimtalkAccount?
  chatBotConfig   ChatBotConfig?
  aligoSendLogs   AligoSendLog[]

  // 셀러 직접 등록 일반상품 & 셀러샵 노출 설정
  directProducts DirectProduct[]
  shopExposure   ShopDirectProductExposure?

  @@map("seller_profiles")
}

// ─────────────────────────────────────────────
// 셀러 일반상품 (셀러가 직접 등록하는 자체 상품 — 관리자 승인 불필요)
// ─────────────────────────────────────────────

model DirectProduct {
  id          String        @id @default(cuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal       @db.Decimal(10, 2)
  description String?       @db.Text
  images      String?       @db.Text // JSON 배열 (이미지 URL)
  stock       Int           @default(0)
  shippingFee Decimal       @default(0) @db.Decimal(10, 2) // 배송비 (원, 0=무료배송)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([sellerId])
  @@map("direct_products")
}

// 셀러샵 "일반상품" 탭 노출 설정 (셀러당 1개)
// productIds: 노출할 DirectProduct id 배열 (JSON, MySQL 배열 미지원)
model ShopDirectProductExposure {
  id              String        @id @default(cuid())
  sellerProfileId String        @unique
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  isEnabled       Boolean       @default(false)
  productIds      String?       @db.Text // JSON 배열 (선택된 상품 id)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("shop_direct_product_exposures")
}

model SellerFollower {
  id        String        @id @default(cuid())
  buyerId   String
  buyer     BuyerProfile  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([buyerId, sellerId])
  @@map("seller_followers")
}

// ─────────────────────────────────────────────
// 추천인 커미션 (레퍼럴 수입)
// ─────────────────────────────────────────────

enum CommissionStatus {
  PENDING
  CONFIRMED
  PAID
  CANCELLED
}

model ReferralCommission {
  id               String           @id @default(cuid())
  sellerId         String
  seller           SellerProfile    @relation(fields: [sellerId], references: [id])
  orderId          String
  order            Order            @relation(fields: [orderId], references: [id])
  buyerUserId      String
  orderAmount      Decimal          @db.Decimal(12, 2)
  commissionRate   Decimal          @db.Decimal(5, 2)
  commissionAmount Decimal          @db.Decimal(12, 2)
  source           String           @default("referral")
  status           CommissionStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("referral_commissions")
}

// ─────────────────────────────────────────────
// 채널 인증 (유튜브/인스타 구독 인증)
// ─────────────────────────────────────────────

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model ChannelVerification {
  id            String             @id @default(cuid())
  buyerId       String
  buyer         BuyerProfile       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId      String
  seller        SellerProfile      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  channelType   String
  screenshotUrl String?            @db.LongText
  status        VerificationStatus @default(PENDING)
  verifiedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([buyerId, sellerId, channelType])
  @@map("channel_verifications")
}

// ─────────────────────────────────────────────
// 브랜드 프로필
// ─────────────────────────────────────────────

model BrandProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandName              String
  brandLogo              String?
  brandBanner            String?
  description            String?  @db.Text
  isApproved             Boolean  @default(false)
  businessRegistrationNo String?
  representativeName     String?
  businessAddress        String?
  businessType           String?
  businessCategory       String?
  contactPhone           String?
  contactEmail           String?

  // 정산용 계좌 정보
  bankName               String?
  accountNumber          String?
  accountHolder          String?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  middleAdminId String?
  middleAdmin   MiddleAdminProfile? @relation(fields: [middleAdminId], references: [id])
  marginMethod  MarginMethod        @default(PERCENTAGE)
  marginBase    MarginBase          @default(SUPPLY)
  marginRate    Decimal             @default(0) @db.Decimal(5, 2)
  commissionRate Decimal            @default(5) @db.Decimal(5, 2)

  // 담당 노드 (중간관리자 없이 노드에 직접 귀속된 브랜드)
  assignedNodeId String?
  assignedNode   User?   @relation("NodeManagedBrands", fields: [assignedNodeId], references: [id])

  products     Product[]
  settlements  BrandSettlement[]

  @@map("brand_profiles")
}

// ─────────────────────────────────────────────
// 브랜드 정산 (수기 처리)
// ─────────────────────────────────────────────

model BrandSettlement {
  id          String       @id @default(cuid())
  brandId     String
  brand       BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)
  periodLabel String
  totalSupply Decimal      @db.Decimal(12, 2)
  totalSales  Decimal      @db.Decimal(12, 2)
  // 실지급액 = 공급가 − 플랫폼 수수료(brandFeeRate × 1.1). 브랜드 정산 가용액에서 차감하는 기준값.
  // (totalSupply 는 수수료 차감 전 공급가라 지급액과 단위가 달라 차감 기준으로 쓸 수 없다)
  settlementAmount Decimal? @db.Decimal(12, 2)
  orderCount  Int          @default(0)
  isPaid      Boolean      @default(false)
  memo        String?      @db.Text
  paidAt      DateTime?
  // 세금계산서
  invoiceStatus      String    @default("NONE") // NONE | REQUESTED | ISSUED
  invoiceRequestedAt DateTime?
  invoiceIssuedAt    DateTime?
  invoiceNumber      String?
  // 생성 주체: null=최고관리자, 값있음=중간관리자 직접 생성
  middleAdminId String?
  middleAdmin   MiddleAdminProfile? @relation("MiddleAdminBrandSettlements", fields: [middleAdminId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("brand_settlements")
}

// ─────────────────────────────────────────────
// 카테고리 (계층 구조 지원)
// ─────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  icon        String?
  image       String?
  description String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  createdAt   DateTime   @default(now())

  products Product[]

  @@index([parentId])
  @@map("categories")
}

// ─────────────────────────────────────────────
// 상품 (브랜드/관리자가 등록)
// ─────────────────────────────────────────────

model Product {
  id                String        @id @default(cuid())
  name              String
  slug              String        @unique
  description       String?       @db.Text
  detailContent     String?       @db.Text
  basePrice         Decimal       @db.Decimal(12, 2)
  comparePrice      Decimal?      @db.Decimal(12, 2)
  supplyPrice       Decimal?      @db.Decimal(12, 2)
  middleAdminMargin Decimal?      @db.Decimal(12, 2)
  adminMargin       Int           @default(0)           // 관리자가 설정한 마진 금액 (원)
  // 제공 방식: SUPPLY(공급가 제공 - 셀러가 판매가 결정) / COMMISSION(수수료 제공 - 판매가·수수료 고정)
  priceModel        PriceModel    @default(SUPPLY)
  commissionRate    Decimal?      @db.Decimal(5, 2)  // 수수료 제공 시 셀러 수수료율(%)
  sellerCommissionAmount Decimal? @db.Decimal(12, 2) // 수수료 제공 시 셀러 수수료 금액(정액)
  categoryId        String?
  category          Category?     @relation(fields: [categoryId], references: [id])
  brandId           String?
  brand             BrandProfile? @relation(fields: [brandId], references: [id])
  middleAdminId     String?
  middleAdmin       MiddleAdminProfile? @relation("MiddleAdminProducts", fields: [middleAdminId], references: [id])
  // ── 노드(NODE) 마진 단계 (nodeEnabled=true 일 때 사용) ──
  nodeMargin        Decimal?      @db.Decimal(12, 2) // 노드가 설정한 마진 (금액 또는 비율)
  nodeMarginType    String?       // "AMOUNT" | "RATE"
  nodeApprovedAt    DateTime?     // 노드가 최종 등록(마진 설정 완료)한 시각
  nodeId            String?       // 최종 등록한 노드 계정 (User.id)
  node              User?         @relation("NodeApprovedProducts", fields: [nodeId], references: [id])
  sellerId          String?
  registrarSeller   SellerProfile? @relation("SellerRegisteredProducts", fields: [sellerId], references: [id])
  isActive          Boolean       @default(true)
  isApproved        Boolean       @default(false)
  allowGroupBuy     Boolean       @default(true)
  allowLiveCommerce Boolean       @default(false)
  badges            String?

  shippingFee           Decimal  @default(0) @db.Decimal(12, 2)
  freeShipping          Boolean  @default(false)
  freeShippingThreshold Decimal? @db.Decimal(12, 2)
  remoteAreaFee         Decimal  @default(0) @db.Decimal(12, 2)

  totalStock   Int      @default(0)
  soldCount    Int      @default(0)
  thumbnail    String?
  // 다차원 옵션 그룹 메타데이터 (JSON): [{groupName: string, options: string[]}]
  // variants는 ProductVariant 테이블에 flat하게 저장 (예: "빨강/S")
  optionGroups String?  @db.Text
  // 외부 플랫폼 최저가 참고용 (셀러 상품 신청 화면에 표시)
  coupangLowestPrice Decimal? @db.Decimal(12, 2)
  naverLowestPrice   Decimal? @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  variants           ProductVariant[]
  images             ProductImage[]
  sellerProducts     SellerShopProduct[]
  campaigns          GroupBuyCampaign[]
  reviews            Review[]
  wishlists          Wishlist[]
  cartItems          CartItem[]
  shoppingTags       ShoppingTag[]
  liveStreamProducts LiveStreamProduct[]
  chats              ProductChat[]
  packageItems       PackageItem[]

  @@map("products")
}

// ─────────────────────────────────────────────
// 위시리스트 (찜 목록)
// ─────────────────────────────────────────────

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

