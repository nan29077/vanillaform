  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  displayOrder Int           @default(0)
  shopNumber   Int?
  sellerNote   String?       @db.Text
  isActive     Boolean       @default(true)
  isApproved   Boolean       @default(false)
  // 셀러가 신청 시 직접 입력한 판매가 (공급가 제공 상품)
  sellerPrice  Decimal?      @db.Decimal(10, 2)
  // 반려/거절 사유 (값이 있으면 반려된 신청 → 셀러에게 사유 표시)
  rejectionReason String?    @db.VarChar(500)
  // 승인 주체: SUPER_ADMIN | MIDDLE_ADMIN | BRAND_ADMIN
  approverType String?
  // 승인 주체 식별자: MIDDLE_ADMIN→MiddleAdminProfile.id, BRAND_ADMIN→BrandProfile.id, SUPER_ADMIN→null
  approverId   String?
