// ─────────────────────────────────────────────
// 주문
// ─────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Order {
  id              String            @id @default(cuid())
  orderNumber     String            @unique
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  sellerId        String
  seller          SellerProfile     @relation("SellerOrders", fields: [sellerId], references: [id])
  campaignId      String?
  campaign        GroupBuyCampaign? @relation(fields: [campaignId], references: [id])
  status          OrderStatus       @default(PENDING)
  paymentStatus   PaymentStatus     @default(PENDING)
  totalAmount     Decimal           @db.Decimal(12, 2)
  shippingFee     Decimal           @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal           @default(0) @db.Decimal(12, 2)
  discountType    String?
  // 장바구니 할인액(셀러 부담) — discountAmount(회사 부담 추천인/픽)와 분리해 정산에서 차감
  cartDiscountAmount Decimal        @default(0) @db.Decimal(12, 2)
  finalAmount     Decimal           @db.Decimal(12, 2)
  shippingName    String?
  shippingPhone   String?
  shippingAddress String?
  shippingMemo    String?
  snsAccounts     String?           @db.Text
  paymentMethod   String?
  pgProvider      String?
  pgTid           String?
  pgAuthData      String?           @db.Text
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  refundedAt      DateTime?
  // 배송 상태 관리 (상품 등록자가 업데이트, 판매 셀러/최고관리자는 조회만)
  // 기본값 없음 — 주문 생성 시점엔 null 이고, PG 결제 성공 콜백이 PAYMENT_COMPLETED 로 채운다.
  // (기본값이 PAYMENT_COMPLETED 였던 탓에 미결제 주문이 마이페이지에 "결제 완료"로 표시되던 버그가 있었음)
  deliveryStatus    String?   // PAYMENT_COMPLETED | PREPARING | SHIPPED | DELIVERING | DELIVERED | CANCELLED | CANCEL_REQUESTED | CANCEL_COMPLETED
  deliveryTracking  String?   // 운송장 번호
  deliveryCourier   String?   // 택배사명
  deliveryUpdatedAt DateTime? // 배송 상태 마지막 업데이트 시각
  deliveryUpdatedBy String?   // 업데이트한 사용자 email

  // ── 결제취소 (셀러 요청 → 관리자 승인) ─────────────────────────────────
  cancelRequestedAt        DateTime?
  cancelRequestedBy        String?            // 요청한 셀러 userId
  cancelReason             String?            @db.Text
  cancelType               String?            // "SAME_DAY" | "POST_DAY"
  cancelStatus             String?            // "REQUESTED" | "DEPOSIT_CONFIRMED" | "APPROVED" | "COMPLETED"
  cancelAmount             Decimal?           @db.Decimal(12, 2)
  cancelDepositConfirmedAt DateTime?
  cancelApprovedAt         DateTime?
  cancelFromSettlement     Boolean            @default(false) // 정산금 차감 여부

  // 주문 시점 셀러 플랫폼 수수료율(%) 스냅샷.
  // OrderItem 이 없는 주문(수기/소셜 주문서 등 상품 매핑 없이 결제된 건)은 아이템 단위
  // 스냅샷을 저장할 곳이 없어, 요율을 바꾸면 과거 정산액이 소급 변동한다. 그 구멍을 막는다.
  sellerFeeRateSnap        Decimal?           @db.Decimal(5, 2)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  items                  OrderItem[]
  referralCommissions    ReferralCommission[]
  middleAdminCommissions MiddleAdminCommission[]

  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // productId 는 FK 가 아니다. itemType 에 따라 가리키는 테이블이 다르다.
  //   PRODUCT → Product.id  (브랜드/관리자/셀러가 등록한 카탈로그 상품)
  //   DIRECT  → DirectProduct.id (셀러가 "일반상품(빠른상품)"으로 직접 등록한 상품)
  // 따라서 productId 로 Product 를 조회하는 코드는 반드시 itemType 을 먼저 확인할 것.
  itemType    String          @default("PRODUCT")
  productId   String
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  productName String
  variantName String?
  price       Decimal         @db.Decimal(12, 2)
  quantity    Int
  totalPrice  Decimal         @db.Decimal(12, 2)
  createdAt   DateTime        @default(now())

  // ── 정산 스냅샷 (주문 시점 고정) ──────────────────────────────────
  // 정산액은 요율·공급가·상품 소유자에 의존하는데 이 값들은 전부 가변이라,
  // 스냅샷이 없으면 나중에 요율을 바꾸는 순간 과거 주문의 정산액이 소급 재계산된다.
  // (2026-07-12 셀러 수수료율 7%→5% 변경으로 6월 정산액이 136,507원 이동한 사고)
  // 아래 값이 있으면 settlement.ts 가 Product 를 다시 읽지 않고 이 값만으로 계산한다.
  // 덕분에 상품이 하드 삭제돼도 정산액이 0원으로 사라지지 않는다.
  // 전부 nullable — 스냅샷 도입 이전 주문은 null 이며, 그 경우에만 라이브 조회로 폴백한다.
  supplyPriceSnap           Decimal? @db.Decimal(12, 2) // 그때의 공급가(단가)
  priceModelSnap            String? // 그때의 priceModel (SUPPLY | COMMISSION | DIRECT=셀러 일반상품)
  productCommissionRateSnap Decimal? @db.Decimal(5, 2) // COMMISSION 상품의 셀러 커미션율(%)
  sellerFeeRateSnap         Decimal? @db.Decimal(5, 2) // 그때의 셀러 플랫폼 수수료율(%)
  supplierFeeRateSnap       Decimal? @db.Decimal(5, 2) // 그때의 공급자 플랫폼 수수료율(%)
  isSellerProductSnap       Boolean? // 판매 셀러가 직접 등록한 상품인지(Case 1 판정)
  recipientRole             String? // 공급분 정산 수취인 역할: SELLER | MIDDLE_ADMIN | BRAND
  recipientId               String? // 공급분 정산 수취인 ID

  @@map("order_items")
}

// ─────────────────────────────────────────────
// 장바구니
// ─────────────────────────────────────────────

model CartItem {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  sellerId   String
  campaignId String?
  quantity   Int             @default(1)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([userId, productId, variantId, sellerId, campaignId])
  @@map("cart_items")
}

