// ─────────────────────────────────────────────
// 멘토 커미션 (셀러 추천인 시스템)
// ─────────────────────────────────────────────

model MentorCommission {
  id               String   @id @default(cuid())
  mentorId         String                         // 추천인(멘토) 셀러의 userId
  menteeId         String                         // 멘티 셀러의 userId
  orderId          String?                        // 연관 주문 ID
  baseAmount       Decimal  @db.Decimal(12, 2)   // 멘티의 해당 주문 결제금액
  commissionRate   Decimal  @db.Decimal(5, 4)    // 커미션율 (예: 0.0100 = 1%)
  commissionAmount Decimal  @db.Decimal(12, 2)   // 실제 커미션 금액
  status           CommissionStatus @default(PENDING)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mentor  User @relation("MentorCommissions", fields: [mentorId], references: [id])
  mentee  User @relation("MenteeCommissions", fields: [menteeId], references: [id])

  @@index([mentorId])
  @@index([menteeId])
  @@map("mentor_commissions")
}

// ─────────────────────────────────────────────
// 출금 요청 (셀러가 정산 가능 금액에 대해 출금 신청)
// ─────────────────────────────────────────────

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

model PayoutRequest {
  id            String        @id @default(cuid())
  sellerId      String
  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(12, 2)
  netAmount     Decimal       @db.Decimal(12, 2)
  orderCount    Int           @default(0)
  // 출금 수수료율(%) — 최고관리자 설정값(Setting: payoutFeeRate), 없으면 0
  commissionRate       Decimal @default(0) @db.Decimal(5, 2)
  // 수수료 차감액 = 출금신청금액 × 수수료율
  commissionAmount     Decimal @default(0) @db.Decimal(12, 2)
  // 원천징수액 = (출금신청금액 - 수수료차감액) × 0.033 (비사업자 셀러만, 사업자는 0)
  withholdingTaxAmount Decimal @default(0) @db.Decimal(12, 2)
  // 실제 입금액 = 출금신청금액 - 수수료차감액 - 원천징수액
  actualPayoutAmount   Decimal @default(0) @db.Decimal(12, 2)
  status        PayoutStatus  @default(REQUESTED)
  isBusiness    Boolean       @default(false)
  bizNumber     String?
  companyName   String?
  bankName      String?
  accountNumber String?
  accountHolder String?
  note          String?       @db.Text
  requestedAt   DateTime      @default(now())
  processedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  orders PayoutRequestOrder[]

  @@index([sellerId])
  @@index([status])
  @@map("payout_requests")
}

// 출금 신청 시점의 주문별 정산 스냅샷 (docs/SETTLEMENT_ISSUES.md #3)
// - 어떤 주문의 정산분이 어느 출금에 얼마나 포함됐는지 고정 기록한다.
// - 신청 금액을 정산일이 빠른 주문부터 FIFO로 배분(allocatedAmount)한다.
// - 이후 수수료율/공급가가 바뀌어도 출금 당시의 근거가 남는다.
model PayoutRequestOrder {
  id               String        @id @default(cuid())
  payoutRequestId  String
  payoutRequest    PayoutRequest @relation(fields: [payoutRequestId], references: [id], onDelete: Cascade)
  orderId          String        // Order.id (스냅샷 성격이라 FK 미설정)
  orderNumber      String        // 조회 편의용 주문번호 스냅샷
  settlementAmount Decimal       @db.Decimal(12, 2) // 신청 시점 이 주문의 정산액(세전)
  allocatedAmount  Decimal       @db.Decimal(12, 2) // 이 출금이 커버하는 금액(부분 출금 배분)
  createdAt        DateTime      @default(now())

  @@unique([payoutRequestId, orderId])
  @@index([orderId])
  @@map("payout_request_orders")
}

// ─────────────────────────────────────────────
// 쿠콘 입금이체PG 거래 로그 (최고관리자 송금)
// ─────────────────────────────────────────────

enum DepositTransferStatus {
  REQUESTED // 요청 직후 (응답 대기)
  SUCCESS // 이체 정상 완료
  FAILED // 이체 실패
  PROCESSING // 은행 처리중 (6170 STS=6)
  UNKNOWN // 타임아웃/001/9980 — 반드시 결과조회(6170) 필요
}

model DepositTransfer {
  id          String                @id @default(cuid())
  trscSeqNo   String // 거래일련번호 (거래일별 고유 12자리)
  reqDate     String // 거래요청일 YYYYMMDD
  rcvBnkCd    String // 입금은행코드
  rcvAcctNo   String // 입금계좌번호
  rcvAcctNm   String? // 입금계좌성명 (예금주)
  amount      Decimal               @db.Decimal(13, 0) // 입금금액(원)
  wdrwAcctNm  String? // 의뢰인명 (상대 통장 인자)
  status      DepositTransferStatus @default(REQUESTED)
  respCd      String? // 처리결과코드
  respMsg     String?               @db.Text
  balAmt      String? // 거래후 출금계좌 잔액
  memo        String?               @db.Text
  createdById String? // 실행한 관리자 userId
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([reqDate, trscSeqNo])
  @@index([status])
  @@index([createdAt])
  @@map("deposit_transfers")
}

// ─────────────────────────────────────────────
// 중간관리자 마진 적립 (주문별) & 정산
// ─────────────────────────────────────────────

model MiddleAdminCommission {
