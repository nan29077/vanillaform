  invoiceRequestedAt DateTime?
  invoiceIssuedAt    DateTime?
  invoiceNumber      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([middleAdminId])
  @@map("middle_admin_settlements")
}

// ─────────────────────────────────────────────
// 노드 정산 (관리자 → 노드)
// ─────────────────────────────────────────────

model NodeSettlement {
